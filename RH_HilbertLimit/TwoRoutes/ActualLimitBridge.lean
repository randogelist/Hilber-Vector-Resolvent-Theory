import RH_HilbertLimit.TwoRoutes.ActualPositivePrefix
import RH_HilbertLimit.TwoRoutes.RouteTwoContractive

/-!
# The precise remaining approximation limit and its proved consequences

The base below is the actual real-axis expression `4 a (a R(a))'`, where
`R` is the literal logarithmic derivative of `AWPIRH.theta`. Higher coefficients
are generated by the archived explicit Widder recursion.

`ActualApproximationConvergence` names an OPEN analytic obligation. It is not an
axiom, has no asserted inhabitant, and is an explicit parameter of every theorem
below that uses it. In particular, this file does not claim a completed second
`H00 -> RiemannHypothesis` route. The expected missing theorem would derive this
convergence from `H00`, by the Hausdorff/actual-resolvent construction.

Prepared without running Lean, Lake, native compiler, or axiom audit.
-/

set_option autoImplicit false
noncomputable section

namespace RH_HilbertLimit.TwoRoutes

open Filter
open scoped Topology

/-- The actual real-axis logarithmic derivative, before any measure model. -/
def actualRealLogDerivative (a : ℝ) : ℝ :=
  (actualLogDerivative (a : ℂ)).re

/-- The actual Widder base in the fixed paper normalization. -/
def actualWidderBase (a : ℝ) : ℝ :=
  4 * a * deriv (fun x : ℝ => x * actualRealLogDerivative x) a

/-- The actual recursively generated coefficient family. No finite approximant
or abstract model is substituted for this definition. -/
def actualWidderMoment (a : ℝ) (n : ℕ) : ℝ :=
  NativeSolobolo.widderTower actualWidderBase n a

@[simp] theorem actualWidderMoment_zero (a : ℝ) :
    actualWidderMoment a 0 = actualWidderBase a := rfl

@[simp] theorem actualWidderMoment_succ (a : ℝ) (n : ℕ) :
    actualWidderMoment a (n + 1) =
      NativeSolobolo.widderStep n (fun x => actualWidderMoment x n) a := rfl

/-- OPEN: the all-order actual identification of the positive approximants.
No theorem in this package constructs a proof of this proposition. -/
def ActualApproximationConvergence : Prop :=
  ∀ a : ℝ, 0 < a → ∀ n : ℕ,
    Tendsto (fun N : ℕ => actualKernelApproximation a N n)
      atTop (𝓝 (actualWidderMoment a n))

/-- If the explicit open convergence is supplied, the finite actual bounds
pass to the actual Widder family by closedness of the real order. -/
theorem actualWidderMoment_bounds_of_convergence
    (h : H00) (hlimit : ActualApproximationConvergence)
    {a : ℝ} (ha : 0 < a) (n : ℕ) :
    0 ≤ actualWidderMoment a n ∧
      actualWidderMoment a n ≤ actualWidderMoment a 0 := by
  constructor
  · apply le_of_tendsto_of_tendsto tendsto_const_nhds (hlimit a ha n)
    exact Filter.Eventually.of_forall
      (fun N => (actualKernelApproximation_bounds h ha N n).1)
  · apply le_of_tendsto_of_tendsto (hlimit a ha n) (hlimit a ha 0)
    exact Filter.Eventually.of_forall
      (fun N => (actualKernelApproximation_bounds h ha N n).2)

theorem actualWidderMoment_abs_le_base_of_convergence
    (h : H00) (hlimit : ActualApproximationConvergence)
    {a : ℝ} (ha : 0 < a) (n : ℕ) :
    |actualWidderMoment a n| ≤ actualWidderMoment a 0 := by
  have hb := actualWidderMoment_bounds_of_convergence h hlimit ha n
  rw [abs_of_nonneg hb.1]
  exact hb.2

/-- Conditional on the named missing limit, the actual coefficient series is
absolutely summable throughout every real radius inside the unit disk. -/
theorem actualWidderMoment_summable_of_convergence
    (h : H00) (hlimit : ActualApproximationConvergence)
    {a r : ℝ} (ha : 0 < a) (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Summable (fun n : ℕ => |actualWidderMoment a n| * r ^ n) := by
  apply NativeSolobolo.Derivations.BKQR.WEIGHTED_COEFF_BOUND_IMPLIES_SUMMABLE_AT_SMALLER_RADIUS
    (fun n => actualWidderMoment a n) (R := 1) (C := actualWidderMoment a 0)
    hr0 (by norm_num) hr1
    (actualWidderMoment_bounds_of_convergence h hlimit ha 0).1
  intro n
  simpa only [one_pow, mul_one] using
    actualWidderMoment_abs_le_base_of_convergence h hlimit ha n

end RH_HilbertLimit.TwoRoutes
